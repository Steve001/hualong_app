<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://java.sun.com/xml/ns/javaee" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd" id="WebApp_ID" version="2.5">
  <display-name>HlManage</display-name>
  <welcome-file-list>
    <welcome-file>login.jsp</welcome-file>
  </welcome-file-list>
  <filter>
    <filter-name>loginFilter</filter-name>
    <filter-class>com.hl.filter.LoginFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>loginFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <servlet>
    <servlet-name>loginServlet</servlet-name>
    <servlet-class>com.hl.web.adminLoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>loginServlet</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>
  
  <!-- 返回空白界面 -->
   <servlet>
  	<servlet-name>blankServlet</servlet-name>
  	<servlet-class>com.hl.web.BlankServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
  	<servlet-name>blankServlet</servlet-name>
  	<url-pattern>/blank</url-pattern>
  </servlet-mapping>
    <!-- 中介管理 -->
     <servlet>
  	<servlet-name>userManagerServlet</servlet-name>
  	<servlet-class>com.hl.web.userManagerServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
  	<servlet-name>userManagerServlet</servlet-name>
  	<url-pattern>/userList</url-pattern>
  </servlet-mapping>
  
  <!-- 修改密码 -->
    <servlet>
  	<servlet-name>passwordServlet</servlet-name>
  	<servlet-class>com.hl.web.PasswordServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
  	<servlet-name>passwordServlet</servlet-name>
  	<url-pattern>/password</url-pattern>
  </servlet-mapping>
  
    <!-- 用户列表-->
    <servlet>
  	<servlet-name>cusListServlet</servlet-name>
  	<servlet-class>com.hl.web.customerManagerServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
  	<servlet-name>cusListServlet</servlet-name>
  	<url-pattern>/cusList</url-pattern>
  </servlet-mapping>
  
</web-app>